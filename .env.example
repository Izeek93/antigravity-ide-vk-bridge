# ==============================================================================
# 🔒 Antigravity IDE VK Bridge Configuration Template
# ==============================================================================

# VK Community Group API Token (Messages permission required)
VK_GROUP_TOKEN=vk1.a.your_vk_group_access_token_here

# VK Community Group ID (numeric ID without minus)
VK_GROUP_ID=123456789

# Allowed VK User IDs (comma-separated whitelist). If empty, auto-captures first incoming user.
VK_ALLOWED_USER_IDS=

# Voice reply synthesis toggle (True/False)
ENABLE_VOICE_REPLIES=True

# Optional: VK User Access Token with 'photos,wall' permissions (required for uploading wall photos)
VK_USER_TOKEN=

# Optional: Peer ID for draft approvals chat (e.g. 2000000005)
VK_APPROVALS_PEER_ID=

# Optional: Peer ID for approved posts backup storage chat (e.g. 2000000006)
VK_STORAGE_PEER_ID=

# Optional: Post footer template with group bridge link
VK_POST_FOOTER_TEMPLATE=Больше интересного — [club{group_id}|ТУТ] 💡
