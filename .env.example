# ==============================================================================
# 🔒 Antigravity IDE VK Bridge Configuration Template
# ==============================================================================

# VK Community Group API Token (Messages permission required)
VK_GROUP_TOKEN=vk1.a.your_vk_group_access_token_here

# Allowed VK User IDs (comma-separated whitelist). If empty, auto-captures first incoming user.
VK_ALLOWED_USER_IDS=

# Voice reply synthesis toggle (True/False)
ENABLE_VOICE_REPLIES=True
